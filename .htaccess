# aleppogift.com .htaccess Configuration
# Hostinger Production: /domains/aleppogift.com/public_html/

# Enable rewrite engine
RewriteEngine On

# Set the base directory
RewriteBase /

# Canonical host: www -> non-www (avoids duplicate indexing)
RewriteCond %{HTTP_HOST} ^www\.(aleppogift\.com)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Serve the database-driven sitemap at the standard location
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Map /dashboard/ to /public/admin/ (avoids WAF blocking /admin/)
RewriteRule ^dashboard/?$ public/admin/index.php [L,QSA]
RewriteRule ^dashboard/(.+)$ public/admin/$1 [L,QSA]

# Backward-compatible redirect: /admin/dashboard/* -> /dashboard/*
RewriteRule ^admin/dashboard/?$ /dashboard/ [R=302,L,NC]
RewriteRule ^admin/dashboard/(.+)$ /dashboard/$1 [R=302,L,NC]

# Redirect bare /admin/ directory access to /admin/login.php (avoids WAF 403 on directory access)
RewriteRule ^admin/?$ /admin/login.php [R=302,L]

# Redirect /public/ URLs to root (clean URLs) - Remove /public from any URL
# Only redirect when the client actually requested a /public/ URL (not internal rewrites)
RewriteCond %{THE_REQUEST} \s/public/ [NC]
RewriteCond %{REQUEST_URI} ^/public(/.*)?$ [NC]
RewriteRule ^public(/(.*))?$ /$2 [R=301,L,QSA]

# Category-only public mode: block cart/checkout and legacy storefront pages
# FIXED: Removed 'product|' from this redirect rule
RewriteRule ^(cart_0|cart_3|checkout_0|checkout_00|thankyou_0|thankyou_00|thankyou_05)\.php$ / [R=302,L,NC]
RewriteRule ^(index00|index007|index07|index5|index6|index7|index99|index_0|index_002|index_099|index_3|index_99|index_no_ar)\.php$ / [R=302,L,NC]

# Redirect all traffic to public folder internally (without changing URL)
# Skip if already accessing public folder
RewriteCond %{REQUEST_URI} !^/public/
# Skip if file exists in root
RewriteCond %{REQUEST_FILENAME} !-f
# Skip if directory exists in root
RewriteCond %{REQUEST_FILENAME} !-d
# For directory requests (ending with /), rewrite to index.php explicitly
RewriteRule ^(.*)/$ /public/$1/index.php [L,QSA]
# Redirect everything else to public folder internally
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /public/$1 [L,QSA]

# Handle direct access to root - redirect to public/index.php
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ /public/index.php [L]

# Custom error pages
ErrorDocument 403 /public/403.php
ErrorDocument 404 /public/404.php
ErrorDocument 500 /public/500.php

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # CORS headers for AJAX endpoints
    # Only apply to ajax directory
    <Files "ajax/*">
        Header always set Access-Control-Allow-Methods "POST, GET, OPTIONS"
        Header always set Access-Control-Allow-Headers "Content-Type, X-Requested-With"
        Header always set Access-Control-Allow-Credentials "true"
        
        # Set allowed origins
        SetEnvIf Origin "^https?://(www\.)?(aleppogift|aleppogift)\.com$" ORIGIN_ALLOWED=$0
        Header always set Access-Control-Allow-Origin "%{ORIGIN_ALLOWED}e" env=ORIGIN_ALLOWED
    </Files>
</IfModule>

# Handle OPTIONS requests for CORS preflight in ajax directory
RewriteCond %{REQUEST_URI} ^/public/ajax/
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Prevent access to sensitive files
<FilesMatch "\.(log|sql|env|ini|bak)$">
    Require all denied
</FilesMatch>

# Prevent access to sensitive directories and files
RewriteRule ^\.git/ - [F,L]
RewriteRule ^logs/ - [F,L]
RewriteRule ^config/ - [F,L]

# Enable gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>